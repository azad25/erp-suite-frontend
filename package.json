{
  "name": "unibase-erp-frontend",
  "version": "2.0.2",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:fast": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "start:fast": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "analyze": "ANALYZE=true npm run build",
    "perf:optimize": "node scripts/optimize-performance.js",
    "perf:audit": "node scripts/performance-audit.js",
    "perf:test": "npm run build && npm run perf:audit",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "perf:bundle": "npm run build:analyze && npx webpack-bundle-analyzer .next/analyze/client.json",
    "perf:nav-test": "node scripts/test-navigation-speed.js",
    "docker:install": "npm install --prefer-offline --no-audit --progress=false",
    "docker:rebuild": "npm rebuild lightningcss --verbose || echo 'LightningCSS rebuild failed, continuing...'",
    "perf:dev": "npm run dev:fast",
    "perf:build": "npm run perf:bundle && npm run dev:webpack",
    "dev:fast": "next dev",
    "dev:classic": "NEXT_DISABLE_TURBOPACK=1 next dev",
    "dev:webpack": "NEXT_DISABLE_TURBOPACK=1 next dev",
    "memory:monitor": "node scripts/memory-optimization.js monitor",
    "memory:cleanup": "node scripts/memory-optimization.js cleanup",
    "memory:tips": "node scripts/memory-optimization.js tips",
    "dev:memory-optimized": "node --max-old-space-size=2048 --expose-gc node_modules/.bin/next dev"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.1.11",
    "apexcharts": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.24",
    "flatpickr": "^4.6.13",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "next": "15.2.3",
    "react": "^19.1.1",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.5",
    "react-intl": "^7.1.11",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-transition-group": "^4.4.12",
    "@types/webpack": "^5.28.5",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "webpack": "^5.96.1",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "overrides": {
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "react-intl": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
